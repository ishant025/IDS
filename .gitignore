# ============================================================
# IDS Project — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environment ───────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Dataset (too large for GitHub — download separately) ──────
data/raw/
# Keep processed data structure but ignore binary arrays
data/processed/*.npy
data/processed/preprocessor.pkl

# ── Trained Models (large binary files) ──────────────────────
models/*.pkl

# ── Logs (runtime generated) ─────────────────────────────────
logs/traffic.jsonl

# ── Database (auto-generated on startup) ──────────────────────
target_server/users.db

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment variables ─────────────────────────────────────
.env
.env.local

# ── Reports figures (generated by pipeline) ───────────────────
# Uncomment below if you don't want to track generated plots:
# reports/figures/*.png
# reports/figures/*.csv

